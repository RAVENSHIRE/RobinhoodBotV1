# Robinhood Chain mainnet (public endpoint is rate-limited)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Fill only after verifying the QuoterV2 deployment and its contract code on chain.
# An independently documented candidate is 0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
QUOTER_V2_ADDRESS=
POLL_INTERVAL=5
BACKFILL_BLOCKS=25
MAX_BLOCK_RANGE=50
MONITOR_MINUTES=12
MAX_ACTIVE_POOLS=25
# Legacy ETH_USD is ignored by the scanner. No fixed-price fallback is allowed.
ETH_USD=
# Both exchange trade prices must be fresh and agree; no API keys required.
# This is an off-chain research reference, not a Robinhood on-chain oracle.
PRICE_FEED_MODE=coinbase_kraken
PRICE_REFRESH_SECONDS=10
PRICE_MAX_AGE_SECONDS=60
PRICE_MAX_DIVERGENCE_PCT=1
PRICE_FUTURE_TOLERANCE_SECONDS=5
QUOTE_MAX_AGE_SECONDS=15
MIN_LIQUIDITY_USD=20000
MIN_VOLATILITY_PCT=1
MAX_VOLATILITY_PCT=100
MIN_CONFIDENCE=0.70
MAX_RISK_SCORE=4
MAX_PRICE_IMPACT_PCT=3
# Launch activity gates from recorded Uniswap V3 Swap events. Unknown values reject entries.
MIN_UNIQUE_BUYERS=3
MAX_TOP_BUYER_SHARE_PCT=50
ACTIVITY_MAX_LAG_SECONDS=30
# Transaction-sender lookups (eth_getTransactionByHash) per scanner cycle.
MAX_TX_LOOKUPS_PER_CYCLE=40
OWNER_RENOUNCED_REQUIRED=true
PAPER_ORDER_USD=25
PAPER_SLIPPAGE_BPS=100
PAPER_FEE_BPS=30
PAPER_STOP_LOSS_PCT=15
PAPER_TAKE_PROFIT_PCT=50
PAPER_MAX_HOLD_SECONDS=900
MAX_OPEN_POSITIONS=3
MAX_PAPER_EXPOSURE_USD=100
MAX_DAILY_LOSS_USD=75
LIVE_MODE=false
DECISION_PROVIDER=stub
# Optional Gemini Developer API (separate from a Gemini app subscription).
# Create in https://aistudio.google.com/apikey using the intended Google Cloud project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
# Persisted per DATA_DIR, UTC day. Includes failed requests and connection checks.
# This bounds calls, not dollars; Google billing budgets are usually alerts, not hard caps.
GEMINI_MAX_CALLS_PER_DAY=100
# Separate, uncalibrated PAPER research thresholds; not JEV probabilities.
GEMINI_MIN_CONFIDENCE=0.85
GEMINI_MAX_RISK_SCORE=3
TYPESAFE_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=10
# prefiltered: call JEV only when every non-model gate already passes (saves credits).
# all: call JEV in every decision window for research, even when the gates must reject.
JEV_CALL_POLICY=prefiltered
DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
